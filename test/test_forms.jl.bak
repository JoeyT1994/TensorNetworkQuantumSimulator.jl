@eval module $(gensym())
using Random
using TensorNetworkQuantumSimulator
using Test: @testset, @test


@testset "Test forms" begin
    Random.seed!(123)
    g = named_grid((3, 3))
    s = siteinds("S=1/2", g)

    #Quadratic Form
    for eltype in [Float32, Float64, ComplexF32, ComplexF64]
        ψ = random_tensornetworkstate(eltype, g, s; bond_dimension = 2)
        ψ = normalize(ψ; alg = "bp")
        ψψ = QuadraticForm(ψ)
        @test ψψ isa QuadraticForm
        @test scalartype(ψψ) == eltype
        @test graph(ψψ) == g

        ψψ_bpc = update(BeliefPropagationCache(ψψ))
        @test partitionfunction(ψψ_bpc) ≈ norm_sqr(ψ; alg = "bp")

        mps_bond_dimension = 16
        ψψ_bmps = update(BoundaryMPSCache(ψψ, mps_bond_dimension))
        @test partitionfunction(ψψ_bmps) ≈ norm_sqr(ψ; alg = "exact")
    end

    #BiLinear Form
    g = named_comb_tree((3, 3))
    s = siteinds("S=1/2", g)
    for eltype in [Float32, Float64, ComplexF32, ComplexF64]
        ψ = random_tensornetworkstate(eltype, g, s; bond_dimension = 3)
        ϕ = random_tensornetworkstate(eltype, g, s; bond_dimension = 4)
        ψ, ϕ = normalize(ψ; alg = "bp"), normalize(ϕ; alg = "bp")
        ψϕ = BilinearForm(ψ, ϕ)
        @test ψϕ isa BilinearForm
        @test scalartype(ψϕ) == eltype
        @test graph(ψϕ) == g

        ψϕ_bpc = update(BeliefPropagationCache(ψϕ))

        @test partitionfunction(ψϕ_bpc) ≈ inner(ψ, ϕ; alg = "bp")
    end

end


# `consume_bra = true` transforms the bra in place. That is only free because `prime` shares
# storage -- and sharing is exactly what makes it dangerous: `apply_gates` replaces only the
# tensors a gate touched, so a bra derived from the ket shares every untouched vertex with it.
# `inner(O, V*O)` -- an echo or perturbation calculation -- is precisely that shape, and
# conjugating those tensors in place corrupts the ket.
#
# This is not hypothetical: it silently changed a production signal from 0.88 to 0.09. A test
# using two *independent* random states cannot see it, which is why the first one did not.
@testset "consume_bra with a bra derived from the ket" begin
    g = named_hexagonal_lattice_graph(2, 2)
    O = random_tensornetworkstate(ComplexF64, g; bond_dimension = 4)
    verts = collect(vertices(g))

    # A circuit over only some vertices, so the rest of M is literally O's tensors.
    M, _ = apply_gates(
        [("Rz", [v], 0.6) for v in verts[1:4]], O;
        apply_kwargs = (; maxdim = 4, cutoff = 1.0e-12),
        bp_update_kwargs = (; maxiter = 8, tolerance = nothing)
    )
    shared = count(v -> TNQS.ITensors.data(M[v]) === TNQS.ITensors.data(O[v]), verts)
    @test shared > 0            # else this test proves nothing

    kw = (; maxiter = 20, tolerance = nothing)
    before = [copy(TNQS.ITensors.data(O[v])) for v in verts]
    ref = TNQS.ITensors.inner(O, M; alg = "bp", cache_update_kwargs = kw)
    got = TNQS.ITensors.inner(O, M; alg = "bp", cache_update_kwargs = kw, consume_bra = true)

    @test isapprox(got, ref; rtol = 1.0e-10)
    # and the ket really was left alone
    @test all(TNQS.ITensors.data(O[v]) == before[i] for (i, v) in enumerate(verts))
end

end
